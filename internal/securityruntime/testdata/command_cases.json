   "args": [
    "grep",
    "hello world",
    "/tmp/a file"
   ]
  },
  {
   "in": "a\tb",
   "from": "added",
   "args": [
    "a",
    "b"
   ]
  },
  {
   "in": "  a   b  ",
   "from": "added",
   "args": [
    "a",
    "b"
   ]
  },
  {
   "in": "a\\ b",
   "from": "added",
   "args": [
    "a b"
   ]
  },
  {
   "in": "'a\\b'",
   "from": "added",
   "args": [
    "a\\b"
   ]
  },
  {
   "in": "\"a\\\"b\"",
   "from": "added",
   "args": [
    "a\"b"
   ]
  },
  {
   "in": "\"a\\b\"",
   "from": "added",
   "args": [
    "ab"
   ]
  },
  {
   "in": "a\"b c\"d",
   "from": "added",
   "args": [
    "ab cd"
   ]
  },
  {
   "in": "a''b",
   "from": "added",
   "args": [
    "ab"
   ]
  },
  {
   "in": "x ''",
   "from": "added",
   "args": [
    "x",
    ""
   ]
  },
  {
   "in": "\\;",
   "from": "added",
   "args": [
    ";"
   ]
  },
  {
   "in": "\"a;b\" 'c|d'",
   "from": "added",
   "args": [
    "a;b",
    "c|d"
   ]
  },
  {
   "in": "$(id) ${HOME} ~",
   "from": "added",
   "args": [
    "$(id)",
    "${HOME}",
    "~"
   ]
  },
  {
   "in": "日本 語",
   "from": "added",
   "args": [
    "日本",
    "語"
   ]
  },
  {
   "in": "",
   "from": "added",
   "error": "command is required"
  },
  {
   "in": "   \t ",
   "from": "added",
   "error": "command is required"
  },
  {
   "in": "''",
   "from": "added",
   "error": "command is required"
  },
  {
   "in": "' ' x",
   "from": "added",
   "error": "command is required"
  },
  {
   "in": "a\\",
   "from": "added",
   "error": "command ends with an incomplete escape"
  },
  {
   "in": "\"abc",
   "from": "added",
   "error": "command contains an unterminated quote"
  },
  {
   "in": "'abc",
   "from": "added",
   "error": "command contains an unterminated quote"
  },
  {
   "in": "a\u0000b",
   "from": "added",
   "error": "command contains a NUL byte"
  },
  {
   "in": "a\nb",
   "from": "added",
   "error": "multiline commands are not supported"
  },
  {
   "in": "a\rb",
   "from": "added",
   "error": "multiline commands are not supported"
  },
  {
   "in": "\"a\nb\"",
   "from": "added",
   "error": "multiline commands are not supported"
  },
  {
   "in": "a\\\nb",
   "from": "added",
   "error": "multiline commands are not supported"
  },
  {
   "in": "a;b",
   "from": "added",
   "error": "shell control operator ';' is not supported"
  },
  {
   "in": "a|b",
   "from": "added",
   "error": "shell control operator '|' is not supported"
  },
  {
   "in": "a&b",
   "from": "added",
   "error": "shell control operator '&' is not supported"
  },
  {
   "in": "a<b",
   "from": "added",
   "error": "shell control operator '<' is not supported"
  },
  {
   "in": "a>b",
   "from": "added",
   "error": "shell control operator '>' is not supported"
  },
  {
   "in": "a`b`",
   "from": "added",
   "error": "shell control operator '`' is not supported"
  },
  {
   "repeat": "a",
   "count": 65537,
   "error": "command exceeds 65536 byte limit",
   "from": "added"
  },
  {
   "repeat": "a",
   "count": 65536,
   "arg_count": 1,
   "from": "added"
  }
 ],
 "exec": [
  {
   "group": "allowlist off with accept-risk",
