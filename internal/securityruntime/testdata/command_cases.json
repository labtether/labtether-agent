     "want": "cmd /c echo probe values must not be empty",
     "from": "added"
    },
    {
     "in": "cmd /c echo a ''",
     "want": "cmd /c echo probe values must not be empty",
     "from": "added"
    },
    {
     "in": "sh -c uptime",
     "want": "command not in allowlist",
     "from": "added"
    },
    {
     "in": "bash",
     "want": "command not in allowlist",
     "from": "added"
    }
   ]
  },
  {
   "group": "links under /proc are followed",
   "env": {},
   "skip_os": [
    "windows",
    "darwin"
   ],
   "cases": [
    {
     "in": "cat /proc/self/root/etc/shadow",
     "want": "reading /proc/self/root/etc/shadow is not allowed here",
     "from": "added"
    }
   ]
  },
  {
   "group": "blank substring setting keeps the default",
   "env": {
    "LABTETHER_SHELL_COMMAND_BLOCKED_SUBSTRINGS": " , "
   },
   "cases": [
    {
     "in": "cat mkfs.log",
     "want": "command blocked by safety policy",
     "from": "added"
    },
    {
     "in": "uptime",
     "want": "allow",
     "from": "added"
    }
   ]
  },
  {
   "group": "shell allowlist off with accept-risk",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_MODE": "false",
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_ACCEPT_RISK": "true"
   },
   "cases": [
    {
     "in": "echo hello",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "cat /etc/shadow",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "shutdown now",
     "want": "command blocked by safety policy",
     "from": "added"
    },
    {
     "in": "uptime; id",
     "want": "shell control operator ';' is not supported",
     "from": "added"
    },
    {
     "in": "rm -rf /",
     "want": "command blocked by safety policy",
     "from": "added"
    }
   ]
  },
  {
   "group": "Go boolean forms for the shell switches",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_MODE": "0",
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_ACCEPT_RISK": "t"
   },
   "cases": [
    {
     "in": "echo hello",
     "want": "allow",
     "from": "added"
    }
   ]
  },
  {
   "group": "exact rule",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "=uptime"
   },
   "cases": [
    {
     "in": "uptime",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "uptime -p",
     "want": "command not in allowlist",
     "from": "added"
    }
   ]
  },
  {
   "group": "interpreter rule takes no extra arguments",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "bash,sh -c uptime"
   },
   "cases": [
    {
     "in": "bash",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "bash -c id",
     "want": "command not in allowlist",
     "from": "added"
    },
    {
     "in": "sh -c uptime",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "sh -c uptime x",
     "want": "command not in allowlist",
     "from": "added"
    }
   ]
  },
  {
   "group": "a quoted rule is one word",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "'systemctl status'"
   },
   "cases": [
    {
     "in": "systemctl status",
     "want": "command not in allowlist",
     "from": "added"
    },
    {
     "in": "'systemctl status'",
     "want": "allow",
     "from": "added"
    }
   ]
  },
  {
   "group": "a rule that does not parse is skipped",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "uptime;,df"
   },
   "cases": [
    {
     "in": "uptime",
     "want": "command not in allowlist",
     "from": "added"
    },
    {
     "in": "df",
     "want": "allow",
     "from": "added"
    }
   ]
  },
  {
   "group": "exact echo rule skips the value check",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "=cmd /c echo"
   },
   "cases": [
    {
     "in": "cmd /c echo",
     "want": "allow",
     "from": "added"
    },
    {
     "in": "cmd /c echo ok",
     "want": "command not in allowlist",
     "from": "added"
    }
   ]
  },
  {
   "group": "the first matching rule decides",
   "env": {
    "LABTETHER_SHELL_COMMAND_ALLOWLIST_PREFIXES": "cmd /c echo,=cmd /c echo"
   },
   "cases": [
    {
     "in": "cmd /c echo",
     "want": "cmd /c is limited to an echo probe with a non-empty ASCII value",
     "from": "added"
    },
    {
     "in": "cmd /c echo ok",
     "want": "allow",
     "from": "added"
    }
   ]
  }
 ]
}
