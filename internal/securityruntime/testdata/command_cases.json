     "in": "custom-binary",
     "want": "refusing to run \"custom-binary\": LABTETHER_EXEC_ALLOWLIST_MODE=false requires LABTETHER_EXEC_ALLOWLIST_ACCEPT_RISK=true to acknowledge that disabling the exec allowlist removes a significant security control",
     "from": "TestValidateExecBinaryBlocksWhenAllowlistDisabledWithoutAcceptRisk"
    }
   ]
  },
  {
   "group": "default mode",
   "env": {
    "LABTETHER_EXEC_ALLOWLIST_MODE": "",
    "LABTETHER_EXEC_ALLOWED_BINARIES": ""
