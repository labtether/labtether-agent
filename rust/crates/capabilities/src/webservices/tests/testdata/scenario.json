 "runs": [
  {
   "name": "main",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    },
    {
     "at": 60
    },
    {
     "at": 121,
     "probes": "later"
    },
    {
     "at": 182
    },
    {
     "at": 190,
     "engine": "fail"
    },
    {
     "at": 200,
     "reconnect": true
    },
    {
     "at": 210,
     "online": false,
     "engine": "a"
    },
    {
     "at": 220,
     "online": true,
     "asset": "nas02",
     "engine": "b",
     "probes": "base-b"
    },
    {
     "at": 230,
     "engine": "many"
    },
    {
     "at": 240,
     "asset": "nas01",
     "engine": "a"
    }
   ],
   "digest": true
  },
  {
   "name": "docker-off",
   "docker": "off",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "no-collector",
   "docker": "none",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "recognition",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "r",
     "probes": "none",
     "sites": "products"
    },
    {
     "at": 60
    }
   ]
  },
  {
   "name": "recognition-cache",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "c",
     "probes": "none",
     "sites": "cache"
    },
    {
     "at": 179
    },
    {
     "at": 180
    },
    {
     "at": 200,
     "sites": "cache-later"
    },
    {
     "at": 299
    },
    {
     "at": 300
    },
    {
     "at": 380
    },
    {
     "at": 599
    },
    {
     "at": 600
    },
    {
     "at": 899
    },
    {
     "at": 900
    }
   ]
  },
  {
   "name": "scan",
   "docker": "on",
   "digest": true,
   "host_ip": "127.0.0.1",
   "capture": [
    1
   ],
   "scan": {
    "ports": "",
    "include_listening": true
   },
   "steps": [
    {
     "at": 0,
     "engine": "s",
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    },
    {
     "at": 60
    },
    {
     "at": 120,
     "listeners": "s2"
    },
    {
     "at": 180,
     "engine": "fail"
    },
    {
     "at": 240,
     "online": false
    },
    {
     "at": 300,
     "online": true,
     "engine": "s",
     "listeners": "s1"
    }
   ]
  },
  {
   "name": "scan-list",
   "docker": "none",
   "host_ip": "127.0.0.1",
   "scan": {
    "ports": "8443, 3000;2222 +80",
    "include_listening": false
   },
   "steps": [
    {
     "at": 0,
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    }
   ]
  },
  {
   "name": "scan-badlist",
   "docker": "none",
   "digest": true,
   "host_ip": "127.0.0.1",
   "scan": {
    "ports": "80,abc",
    "include_listening": false
   },
   "steps": [
    {
     "at": 0,
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    }
   ]
  }
