 "runs": [
  {
   "name": "main",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    },
    {
     "at": 60
    },
    {
     "at": 121,
     "probes": "later"
    },
    {
     "at": 182
    },
    {
     "at": 190,
     "engine": "fail"
    },
    {
     "at": 200,
     "reconnect": true
    },
    {
     "at": 210,
     "online": false,
     "engine": "a"
    },
    {
     "at": 220,
     "online": true,
     "asset": "nas02",
     "engine": "b",
     "probes": "base-b"
    },
    {
     "at": 230,
     "engine": "many"
    },
    {
     "at": 240,
     "asset": "nas01",
     "engine": "a"
    }
   ],
   "digest": true
  },
  {
   "name": "docker-off",
   "docker": "off",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "no-collector",
   "docker": "none",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "recognition",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "r",
     "probes": "none",
     "sites": "products"
    },
    {
     "at": 60
    }
   ]
  },
  {
   "name": "recognition-cache",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "c",
     "probes": "none",
     "sites": "cache"
    },
    {
     "at": 179
    },
    {
     "at": 180
    },
    {
     "at": 200,
     "sites": "cache-later"
    },
    {
     "at": 299
    },
    {
     "at": 300
    },
    {
     "at": 380
    },
    {
     "at": 599
    },
    {
     "at": 600
    },
    {
     "at": 899
    },
    {
     "at": 900
    }
   ]
  },
  {
   "name": "scan",
   "docker": "on",
   "digest": true,
   "host_ip": "127.0.0.1",
   "capture": [
    1
   ],
   "scan": {
    "ports": "",
    "include_listening": true
   },
   "steps": [
    {
     "at": 0,
     "engine": "s",
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    },
    {
     "at": 60
    },
    {
     "at": 120,
     "listeners": "s2"
    },
    {
     "at": 180,
     "engine": "fail"
    },
    {
     "at": 240,
     "online": false
    },
    {
     "at": 300,
     "online": true,
     "engine": "s",
     "listeners": "s1"
    }
   ]
  },
  {
   "name": "scan-list",
   "docker": "none",
   "host_ip": "127.0.0.1",
   "scan": {
    "ports": "8443, 3000;2222 +80",
    "include_listening": false
   },
   "steps": [
    {
     "at": 0,
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    }
   ]
  },
  {
   "name": "scan-badlist",
   "docker": "none",
   "digest": true,
   "host_ip": "127.0.0.1",
   "scan": {
    "ports": "80,abc",
    "include_listening": false
   },
   "steps": [
    {
     "at": 0,
     "probes": "none",
     "sites": "scan",
     "listeners": "s1"
    }
   ]
  },
  {
   "name": "proxy-traefik",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": true,
    "caddy": false,
    "npm": false,
    "env": {
     "LABTETHER_TRAEFIK_USER": "ltqa",
     "LABTETHER_TRAEFIK_PASSWORD": "made-up"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "t-ok"
    },
    {
     "at": 60
    },
    {
     "at": 120,
     "api": "t-fail"
    },
    {
     "at": 180
    },
    {
     "at": 240,
     "reconnect": true
    },
    {
     "at": 300,
     "engine": "p-stopped",
     "api": "t-ok"
    },
    {
     "at": 360,
     "engine": "p-labels",
     "api": "t-labels"
    },
    {
     "at": 420,
     "engine": "p",
     "api": "t-ok"
    }
   ]
  },
  {
   "name": "proxy-traefik-manual",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": true,
    "caddy": false,
    "npm": false,
    "env": {
     "LABTETHER_TRAEFIK_URL": "http://localhost:18391//"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "c",
     "api": "t-manual"
    }
   ]
  },
  {
   "name": "proxy-caddy",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": true,
    "npm": false,
    "env": {}
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "c-ok"
    },
    {
     "at": 60,
     "api": "c-403"
    },
    {
     "at": 120,
     "api": "c-null"
    },
    {
     "at": 180,
     "engine": "p-noadmin",
     "api": "c-ok"
    },
    {
     "at": 240,
     "engine": "fail",
     "api": "c-ok"
    }
   ]
  },
  {
   "name": "proxy-npm-default",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": false,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\""
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "n-ok"
    },
    {
     "at": 60
    }
   ]
  },
  {
   "name": "proxy-npm-nologin",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": false,
    "npm": true,
    "env": {
     "LABTETHER_ALLOW_INSECURE_TRANSPORT": "true",
     "LABTETHER_OUTBOUND_ALLOW_LOOPBACK": "true",
     "LABTETHER_NPM_EMAIL": "ltqa@example.com"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "n-ok"
    }
   ]
  },
  {
   "name": "proxy-npm",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": false,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\"",
     "LABTETHER_ALLOW_INSECURE_TRANSPORT": "true",
     "LABTETHER_OUTBOUND_ALLOW_LOOPBACK": "true"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "n-ok"
    },
    {
     "at": 60
    },
    {
     "at": 120,
     "api": "n-401"
    },
    {
     "at": 180,
     "api": "n-gone"
    }
   ]
  },
  {
   "name": "proxy-npm-http",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": false,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\"",
     "LABTETHER_NPM_URL": "http://localhost:18383",
     "LABTETHER_OUTBOUND_ALLOW_LOOPBACK": "true",
     "LABTETHER_OUTBOUND_ALLOWED_SCHEMES": "http,https"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "n-ok"
    }
   ]
  },
  {
   "name": "proxy-npm-url",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": false,
    "caddy": false,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\"",
     "LABTETHER_ALLOW_INSECURE_TRANSPORT": "true",
     "LABTETHER_OUTBOUND_ALLOW_LOOPBACK": "true",
     "LABTETHER_NPM_URL": " http://npm.ltqa.example:81/base/ ",
     "LABTETHER_OUTBOUND_ALLOWLIST_MODE": "true",
     "LABTETHER_OUTBOUND_ALLOWED_HOSTS": "*.ltqa.example, 10.0.0.0/8"
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "c",
     "api": "n-url"
    }
   ]
  },
  {
   "name": "proxy-mixed",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": true,
    "traefik": true,
    "caddy": true,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\""
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "mixed"
    },
    {
     "at": 60
    }
   ]
  },
  {
   "name": "proxy-off",
   "docker": "on",
   "digest": true,
   "digest_health": true,
   "proxy": {
    "enabled": false,
    "traefik": true,
    "caddy": true,
    "npm": true,
    "env": {
     "LABTETHER_NPM_EMAIL": "ltqa@example.com",
     "LABTETHER_NPM_PASSWORD": "made-up <pw>&\"x\""
    }
   },
   "steps": [
    {
     "at": 0,
     "engine": "p",
     "api": "mixed"
    }
   ]
  }
 ],
