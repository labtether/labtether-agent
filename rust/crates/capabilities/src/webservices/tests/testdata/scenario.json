  {
   "name": "main",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    },
    {
     "at": 60
    },
    {
     "at": 121,
     "probes": "later"
    },
    {
     "at": 182
    },
    {
     "at": 190,
     "engine": "fail"
    },
    {
     "at": 200,
     "reconnect": true
    },
    {
     "at": 210,
     "online": false,
     "engine": "a"
    },
    {
     "at": 220,
     "online": true,
     "asset": "nas02",
     "engine": "b",
     "probes": "base-b"
    },
    {
     "at": 230,
     "engine": "many"
    },
    {
     "at": 240,
     "asset": "nas01",
     "engine": "a"
    }
   ],
   "digest": true
  },
  {
   "name": "docker-off",
   "docker": "off",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "no-collector",
   "docker": "none",
   "steps": [
    {
     "at": 0,
     "engine": "a",
     "probes": "base"
    }
   ]
  },
  {
   "name": "recognition",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "r",
     "probes": "none",
     "sites": "products"
    },
    {
     "at": 60
    }
   ]
  },
  {
   "name": "recognition-cache",
   "docker": "on",
   "steps": [
    {
     "at": 0,
     "engine": "c",
     "probes": "none",
     "sites": "cache"
    },
    {
     "at": 179
    },
    {
     "at": 180
    },
    {
     "at": 200,
     "sites": "cache-later"
    },
    {
     "at": 299
    },
